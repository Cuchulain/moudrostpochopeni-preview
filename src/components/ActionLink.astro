---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'text';
  ariaLabel?: string;
}

const { href, variant = 'primary', ariaLabel } = Astro.props;
---

<a class:list={['action-link', `action-link--${variant}`]} href={href} aria-label={ariaLabel}>
  <slot />
  <svg aria-hidden="true" viewBox="0 0 20 20">
    <path d="M4 10h11M11 6l4 4-4 4" />
  </svg>
</a>
